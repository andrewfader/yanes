+/* YANES oracle hook. The frontend publishes YANES_FRAME_INDEX immediately before
+ * retro_run(); combined with the core's frame-local master-clock timestamp it
+ * gives an unambiguous timeline without changing the libretro ABI. One raw
+ * SN76489 data byte is logged per write; the replay reconstructs the latch/data
+ * protocol. Master clock is NTSC 53693175 Hz, 896040 M-cycles/frame. Raw POSIX
+ * I/O is used because the core remaps stdio FILE/fopen onto its own VFS. */
+static int yanes_psg_fd = -2;
+
 void psg_write(unsigned int clocks, unsigned int data)
 {
   int index;
 
+  if (yanes_psg_fd == -2)
+  {
+    const char *path = getenv("YANES_PSG_LOG");
+    yanes_psg_fd = path ? open(path, O_WRONLY | O_CREAT | O_TRUNC, 0644) : -1;
+  }
+  if (yanes_psg_fd >= 0)
+  {
+    const char *frame = getenv("YANES_FRAME_INDEX");
+    char line[64];
+    int n = snprintf(line, sizeof(line), "%s %u %02x\n", frame ? frame : "0", clocks, data & 0xff);
+    if (n > 0) { ssize_t w = write(yanes_psg_fd, line, (size_t)n); (void)w; }
+  }
+
   /* PSG chip synchronization */
   if (clocks > psg.clocks)
